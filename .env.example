# PostgreSQL (used by Prisma for guestbook)
# DATABASE_URL can be a pooled connection string (e.g. Supabase pooler / Prisma Accelerate)
# DIRECT_URL must be a direct (non-pooled) connection for Prisma migrations
DATABASE_URL=postgresql://user:password@host:5432/dbname
DIRECT_URL=postgresql://user:password@host:5432/dbname

# Redis (used for rate limiting and counters)
REDIS_URL=redis://localhost:6379

# Discord webhook (used for guestbook notifications)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# SMTP (used for contact form)
# For Gmail: enable 2FA then generate an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=your-email@gmail.com

# Contact form destination
CONTACT_TO_EMAIL=ethandavidfrancis@gmail.com
